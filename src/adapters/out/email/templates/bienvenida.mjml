<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text font-family="Helvetica, Arial, sans-serif" line-height="1.6" color="#333333" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-include path="./partials/header.mjml" />
    <mj-section background-color="#ffffff" padding="40px 32px">
      <mj-column>
        <mj-text font-size="26px" font-weight="bold" align="center" color="#111111" padding-bottom="8px">¡Tu cuenta está activa!</mj-text>
        <mj-text align="center" font-size="16px" color="#555555" padding-bottom="4px">Hola {{nombre}},</mj-text>
        <mj-text align="center" font-size="16px" color="#555555" padding-bottom="4px">Tu correo electrónico fue verificado correctamente. Tu cuenta ya está activa y podés iniciar sesión para empezar a reservar tus turnos.</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>
